# =============================================================================
# OpenVEPA Docker Environment Configuration
# =============================================================================
# Copy this file to .env in the project root:
#   cp docker/.env.example .env
#
# Docker Compose automatically reads .env from the same directory.
# =============================================================================

# --- Server ---
# Port for the OpenVEPA web interface and API
OPENVEPA_PORT=8371

# --- SSH Access ---
# Set to "true" to enable SSH into the container
SSH_ENABLED=false
# Host port mapped to container SSH (port 22)
SSH_PORT=2222

# --- AI Provider ---
# "ollama" (local, free) or "openai" (cloud, requires API key)
# Leave empty to use the WebUI setup wizard on first run
OPENVEPA_PROVIDER=
# Model identifier (e.g., "llama3.2", "gpt-4o")
OPENVEPA_MODEL=
# OpenAI API key (only needed if provider is "openai")
OPENVEPA_API_KEY=

# --- Ollama ---
# Ollama endpoint (use "http://ollama:11434" when using the Ollama sidecar)
OPENVEPA_OLLAMA_ENDPOINT=http://ollama:11434
# Host port for Ollama API (only used with --profile with-ollama)
OLLAMA_PORT=11434
